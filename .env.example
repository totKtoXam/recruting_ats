# --- Приложение ---
NODE_ENV=development
PORT=3000
# Адрес, на котором слушает сервер; за nginx на той же машине — 127.0.0.1. Пусто — все интерфейсы.
HOST=
# Публичный URL приложения (используется в OAuth redirect и ссылках черновиков).
# Может содержать путь: https://office.devexpert.kz/recruiting — тогда все маршруты работают под /recruiting.
PUBLIC_URL=http://localhost:3000
APP_TIMEZONE=Asia/Almaty
# true, если приложение стоит за reverse proxy (nginx, load balancer) с HTTPS.
TRUST_PROXY=false

# --- PostgreSQL ---
DATABASE_URL=postgres://ats:ats@localhost:5432/ats
DATABASE_SSL=false

# --- Сессии ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=14

# --- Авторизация ---
# google — вход через Google OAuth; dev — вход по email без пароля (только для локальной разработки).
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Кому разрешено входить (через запятую). Без allowlist доступ получает только первый вошедший пользователь; в production allowlist обязателен.
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# --- Google Drive (хранилище резюме) ---
# ID папки «Кандидаты»: https://drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# oauth — от имени Google-аккаунта-владельца папки (обычный Gmail подходит);
# service_account — сервисный аккаунт, папка должна быть на общем диске (Shared Drive) Google Workspace.
GOOGLE_DRIVE_AUTH=oauth
# Для oauth: получить командой npm run drive:auth (OAuth-клиент берётся из GOOGLE_CLIENT_ID/SECRET).
GOOGLE_DRIVE_REFRESH_TOKEN=
# Необязательно: отдельный OAuth-клиент для Drive.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Для service_account: JSON-ключ одной строкой (или путь к файлу в GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# --- Resume Intake API ---
# Сгенерировать: node -e "console.log('ats_'+require('crypto').randomBytes(24).toString('hex'))"
ATS_API_KEY=
