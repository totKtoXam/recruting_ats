# --- Приложение ---
NODE_ENV=development
PORT=3040
# Адрес для прослушивания. 127.0.0.1 — приложение доступно только через reverse proxy (nginx).
# Пусто — все интерфейсы.
HOST=
# Публичный URL приложения (используется в OAuth redirect и ссылках черновиков).
PUBLIC_URL=http://localhost:3040
APP_TIMEZONE=Asia/Almaty
# Префикс пути, если приложение открыто не в корне домена (например, /hr-ats за nginx).
# PUBLIC_URL тогда должен включать его: https://portal.example.com/hr-ats
BASE_PATH=
# true, если приложение стоит за reverse proxy (nginx, load balancer) с HTTPS.
TRUST_PROXY=false

# --- PostgreSQL ---
DATABASE_URL=postgres://ats:ats@localhost:5432/ats
DATABASE_SSL=false

# --- Сессии ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Необязательно: ключ шифрования секретов из «Настройки → Интеграции» (по умолчанию из SESSION_SECRET).
SETTINGS_ENCRYPTION_KEY=
SESSION_MAX_AGE_DAYS=14
# Имя cookie сессии. Задайте своё, если на одном домене несколько приложений.
SESSION_COOKIE_NAME=ats.sid

# --- Авторизация ---
# google — вход через Google OAuth; dev — вход по email без пароля (только для локальной разработки).
AUTH_MODE=dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Администраторы (через запятую): всегда имеют доступ и открывают его другим пользователям
# в «Настройки → Пользователи». Войти через Google может любой аккаунт, но без открытого
# доступа он попадает в список «Ожидает доступа». В production обязателен.
AUTH_ADMIN_EMAILS=
# Необязательно: кому доступ открывается автоматически (без прав администратора).
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# --- Google Drive (хранилище резюме) ---
# ID папки «Кандидаты»: https://drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# oauth — от имени Google-аккаунта-владельца папки (обычный Gmail подходит);
# service_account — сервисный аккаунт, папка должна быть на общем диске (Shared Drive) Google Workspace.
GOOGLE_DRIVE_AUTH=oauth
# Для oauth: получить командой npm run drive:auth (OAuth-клиент берётся из GOOGLE_CLIENT_ID/SECRET).
GOOGLE_DRIVE_REFRESH_TOKEN=
# Необязательно: отдельный OAuth-клиент для Drive.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Для service_account: JSON-ключ одной строкой (или путь к файлу в GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=

# --- Публичная страница /privacy (ссылка для Google Auth Platform → Branding) ---
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=

# --- Email-уведомления (SMTP). Без SMTP_HOST письма не отправляются ---
# Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=noreply@домен,
# SMTP_PASS=пароль приложения (Аккаунт Google → Безопасность → Пароли приложений, нужна 2FA).
SMTP_HOST=
SMTP_PORT=587
# true — TLS сразу (порт 465), false — STARTTLS (порт 587). По умолчанию true только для 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Отправитель, например: Recruiting ATS <noreply@example.com>. По умолчанию SMTP_USER.
MAIL_FROM=

# --- Telegram-бот (привязка Telegram пользователей и уведомления) ---
# Создать бота: @BotFather → /newbot, токен вида 123456:ABC...
TELEGRAM_BOT_TOKEN=
# Получение сообщений long polling-ом. false — на всех экземплярах, кроме одного.
TELEGRAM_POLLING=true

# --- Resume Intake API ---
# Сгенерировать: node -e "console.log('ats_'+require('crypto').randomBytes(24).toString('hex'))"
ATS_API_KEY=
