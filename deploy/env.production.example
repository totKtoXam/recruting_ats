# /etc/recruiting-ats/env — владелец root:recruiting, права 640.
# setup.sh создаёт файл из этого шаблона и генерирует SESSION_SECRET и ATS_API_KEY.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://portal.devexpert.kz/recruiting
TRUST_PROXY=true
APP_TIMEZONE=Asia/Almaty

# Отдельная роль приложения, подключение напрямую к PostgreSQL (не через Warpgate).
DATABASE_URL=postgres://recruiting:CHANGE_ME@127.0.0.1:5432/recruiting
DATABASE_SSL=false

SESSION_SECRET=
SESSION_MAX_AGE_DAYS=14

AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAINS=devexpert.kz
AUTH_ALLOWED_EMAILS=

GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_AUTH=oauth
GOOGLE_DRIVE_REFRESH_TOKEN=

ATS_API_KEY=
